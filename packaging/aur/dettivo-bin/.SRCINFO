pkgbase = dettivo-bin
	pkgdesc = Speech workstation for Omarchy: dictation, meetings and history on local engines (release build)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/gmickel/dettivo-linux
	install = dettivo-bin.install
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-wayland
	depends = qt6-multimedia
	depends = libglvnd
	depends = tomlplusplus
	depends = layer-shell-qt
	depends = wayland
	depends = libxkbcommon
	depends = libpipewire
	depends = pipewire
	depends = vulkan-icd-loader
	depends = hicolor-icon-theme
	optdepends = omarchy: the bar plugin and `dettivo setup omarchy`
	optdepends = ollama: a remote language model endpoint for Enhanced
	optdepends = vulkan-driver: run the engines on the GPU; without one they run on the CPU
	optdepends = ttf-cascadia-mono-nerd: the monospace face the pill and the app render with
	provides = dettivo
	conflicts = dettivo
	options = !lto
	source = https://github.com/gmickel/dettivo-linux/releases/download/v0.2.0/dettivo-0.2.0-linux-x86_64.tar.zst
