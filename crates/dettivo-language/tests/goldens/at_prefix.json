{
  "source": "DettivoTests/Polish/PostProcessorsTests.swift",
  "note": "PostProcessors.addAtPrefixToFilePaths(input) on its own: idempotent, URL, email and glued relative paths left alone.",
  "cases": [
    { "name": "simple_filename", "input": "check foo.swift", "expected": "check @foo.swift" },
    { "name": "path", "input": "see src/main.ts", "expected": "see @src/main.ts" },
    { "name": "relative_here", "input": "edit ./foo.swift", "expected": "edit @./foo.swift" },
    { "name": "relative_parent", "input": "see ../bar.ts", "expected": "see @../bar.ts" },
    { "name": "relative_path", "input": "check ./src/main.ts", "expected": "check @./src/main.ts" },
    { "name": "relative_parent_path", "input": "update ../lib/utils.py", "expected": "update @../lib/utils.py" },
    { "name": "idempotent", "input": "edit @foo.swift", "expected": "edit @foo.swift" },
    { "name": "idempotent_relative", "input": "check @./src/main.ts", "expected": "check @./src/main.ts" },
    { "name": "preserves_https_url", "input": "see https://example.com/foo.swift", "expected": "see https://example.com/foo.swift" },
    { "name": "preserves_http_url", "input": "link http://x.y/z/bar.md", "expected": "link http://x.y/z/bar.md" },
    { "name": "preserves_email", "input": "contact user@example.com", "expected": "contact user@example.com" },
    { "name": "multiple_files", "input": "update foo.md and bar.swift", "expected": "update @foo.md and @bar.swift" },
    { "name": "ignores_version_number", "input": "version 1.0 is great", "expected": "version 1.0 is great" },
    { "name": "start_of_line", "input": "foo.swift is the file", "expected": "@foo.swift is the file" },
    { "name": "end_of_line", "input": "check out foo.swift", "expected": "check out @foo.swift" },
    { "name": "punctuation", "input": "see foo.swift, bar.md.", "expected": "see @foo.swift, @bar.md." },
    { "name": "extension_md", "input": "check file.md", "expected": "check @file.md" },
    { "name": "extension_swift", "input": "check file.swift", "expected": "check @file.swift" },
    { "name": "extension_txt", "input": "check file.txt", "expected": "check @file.txt" },
    { "name": "extension_json", "input": "check file.json", "expected": "check @file.json" },
    { "name": "extension_yml", "input": "check file.yml", "expected": "check @file.yml" },
    { "name": "extension_yaml", "input": "check file.yaml", "expected": "check @file.yaml" },
    { "name": "extension_ts", "input": "check file.ts", "expected": "check @file.ts" },
    { "name": "extension_js", "input": "check file.js", "expected": "check @file.js" },
    { "name": "extension_jsx", "input": "check file.jsx", "expected": "check @file.jsx" },
    { "name": "extension_tsx", "input": "check file.tsx", "expected": "check @file.tsx" },
    { "name": "extension_py", "input": "check file.py", "expected": "check @file.py" },
    { "name": "extension_sh", "input": "check file.sh", "expected": "check @file.sh" },
    { "name": "extension_css", "input": "check file.css", "expected": "check @file.css" },
    { "name": "extension_html", "input": "check file.html", "expected": "check @file.html" },
    { "name": "extension_xml", "input": "check file.xml", "expected": "check @file.xml" },
    { "name": "extension_plist", "input": "check file.plist", "expected": "check @file.plist" },
    { "name": "unknown_extension_docx", "input": "check file.docx", "expected": "check file.docx" },
    { "name": "unknown_extension_pdf", "input": "check file.pdf", "expected": "check file.pdf" },
    { "name": "unknown_extension_exe", "input": "check file.exe", "expected": "check file.exe" }
  ]
}
