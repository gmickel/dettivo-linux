// Dettivo dictation bindings. Generated by `dettivo setup niri`; change the
// keys in ~/.config/dettivo/config.toml ([hotkeys]) and run it again.
// Load it from ~/.config/niri/config.kdl: include "dettivo.kdl"
// Niri has no release bindings, so hold to talk is absent here: Mod+Ctrl+X
// toggles instead (one press starts, the next stops). The hold chord
// (F9) still works through the portal backend where a portal exists.
binds {
    Mod+Ctrl+X { spawn "dettivo" "--quiet" "dictation" "toggle"; }
    Mod+Ctrl+Escape { spawn "dettivo" "--quiet" "dictation" "cancel"; }
    Mod+Ctrl+Shift+X { spawn "dettivo" "--quiet" "dictation" "reinsert-last"; }
}
