# Dettivo dictation bindings. Generated by `dettivo setup sway`; change the
# keys in ~/.config/dettivo/config.toml ([hotkeys]) and run it again.
# Load it from ~/.config/sway/config: include ~/.config/sway/dettivo
# Hold to talk: press starts, release stops.
bindsym F9 exec dettivo --quiet dictation start
bindsym --release F9 exec dettivo --quiet dictation stop
# Toggle: one press starts, the next stops.
bindsym Mod4+Ctrl+x exec dettivo --quiet dictation toggle
bindsym Mod4+Ctrl+Escape exec dettivo --quiet dictation cancel
bindsym Mod4+Ctrl+Shift+x exec dettivo --quiet dictation reinsert-last
