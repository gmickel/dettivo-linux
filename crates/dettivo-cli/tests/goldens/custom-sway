# Dettivo dictation bindings. Generated by `dettivo setup sway`; change the
# keys in ~/.config/dettivo/config.toml ([hotkeys]) and run it again.
# Load it from ~/.config/sway/config: include ~/.config/sway/dettivo
# Hold to talk: press starts, release stops.
bindsym Mod4+Alt+space exec dettivo --quiet dictation start
bindsym --release Mod4+Alt+space exec dettivo --quiet dictation stop
# Toggle: one press starts, the next stops.
bindsym Mod4+Alt+d exec dettivo --quiet dictation toggle
bindsym Mod4+Alt+Escape exec dettivo --quiet dictation cancel
bindsym Mod4+Alt+Shift+d exec dettivo --quiet dictation reinsert-last
