// Dettivo dictation bindings. Generated by `dettivo setup niri`; change the
// keys in ~/.config/dettivo/config.toml ([hotkeys]) and run it again.
// Load it from ~/.config/niri/config.kdl: include "dettivo.kdl"
// Niri has no release bindings, so hold to talk is absent here: Mod+Alt+D
// toggles instead (one press starts, the next stops). The hold chord
// (Mod+Alt+space) still works through the portal backend where a portal exists.
binds {
    Mod+Alt+D { spawn "dettivo" "--quiet" "dictation" "toggle"; }
    Mod+Alt+Escape { spawn "dettivo" "--quiet" "dictation" "cancel"; }
    Mod+Alt+Shift+D { spawn "dettivo" "--quiet" "dictation" "reinsert-last"; }
}
